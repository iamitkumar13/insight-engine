{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: uvicorn (reload)",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servers" }
    },
    {
      "label": "frontend: vite dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servers" }
    },
    {
      "label": "run app (backend + frontend)",
      "dependsOn": ["backend: uvicorn (reload)", "frontend: vite dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
