# --- LLM provider selection ---
# "hf" = Hugging Face Inference API (open-source default)
# "anthropic" = Claude API
LLM_PROVIDER=hf

# --- Hugging Face ---
# Get a token at https://huggingface.co/settings/tokens (a free read token works)
HF_TOKEN=
# Pick any chat-completion-capable model hosted on the HF Inference API.
# Strong choices for NL->SQL:
#   Qwen/Qwen2.5-Coder-32B-Instruct
#   meta-llama/Llama-3.3-70B-Instruct
#   mistralai/Mistral-7B-Instruct-v0.3
HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Server ---
APP_HOST=127.0.0.1
APP_PORT=8000

# Frontend dev origin allowed by CORS
CORS_ORIGIN=http://localhost:5173
